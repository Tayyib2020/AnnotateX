NODE_ENV=development
PORT=4000

# Comma-separated browser origins allowed to call the API with credentials.
# Keep empty for same-origin local development; set the deployed HTTPS origin in production.
FRONTEND_ORIGINS=

# Required in production. Generate a random value of at least 32 characters.
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters

# Current AnnotateX Bradbury Intelligent Contract. Leave blank until configured.
GENLAYER_CONTRACT=
GENLAYER_CHAIN_ID=0x107d
GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
GENLAYER_EXPLORER_URL=https://explorer-bradbury.genlayer.com/

# Local JSON fallback directory for development only. Production uses DATABASE_URL instead.
ANNOTATEX_DATA_DIR=

# Production requires a Neon (or other PostgreSQL) connection string. Keep it private.
DATABASE_URL=
# Set true only for a one-time import of local users.json and marketplace.json into an empty database.
DATABASE_IMPORT_LOCAL_DATA=false
